{
  "manifest_version": 3,
  "name": "Genesys Wallboard Agent Cards",
  "version": "0.6.0",
  "description": "Restyles the Genesys agent list into status cards and adds click-to-dial from your dispatch site. Enable sites from the popup.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": [
    "https://YOUR-DISPATCH-HOST/*",
    "https://YOUR-GENESYS-HOST/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Agent Cards settings",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
